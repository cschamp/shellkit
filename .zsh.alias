alias c='cd ..'
alias cp='cp -i'
alias d='dirs -v'
alias df='df -H'
alias diff='diff -u'
alias digs='dig +short'
alias dos2unix="perl -i -pe 's/\r$//'"
alias grep='grep --color=auto'
alias la='ls -a'
alias ll='ls -hl'
alias m='mount'
alias more="$PAGER"
alias mv='mv -i'
alias pd='pushd'
alias pp='popd'
alias psall='ps auxww'
alias rm='rm -i'
alias x='exit'
alias wai='who am i'
alias zman='run-help'
alias zmore='zless'

case $OSTYPE in
  darwin*) alias ls='ls -GAF'; alias top='top -s 1' ;;
  linux*)  alias ls='ls --color=auto -AF'; alias top='top -d 1' ;;
  *)       alias ls='ls -AF' ;;
esac
