bak() {
  if (( $# != 1 )); then
    print -u2 'usage: bak path'
    return 2
  fi
  command cp -iRp -- "$1" "$1.bak"
}

unbak() {
  if (( $# != 1 )) || [[ $1 != *.bak ]]; then
    print -u2 'usage: unbak path.bak'
    return 2
  fi
  command cp -iRp -- "$1" "${1%.bak}"
}

cdc() {
  if (( $# != 1 )); then
    print -u2 'usage: cdc directory'
    return 2
  fi
  command mkdir -p -- "$1" && builtin cd -- "$1"
}

# Search interactive shell history. The name is retained for compatibility;
# Mercurial is not installed on this system.
hg() {
  if (( $# == 0 )); then
    print -u2 'usage: hg pattern'
    return 2
  fi
  fc -l 1 | command grep -- "$@"
}

mk() {
  command make "$@" 2>&1 | command tee "errs$$.log"
  local make_status=$pipestatus[1]
  return $make_status
}

mvc() {
  if (( $# < 2 )); then
    print -u2 'usage: mvc source ... destination'
    return 2
  fi
  local destination=${argv[-1]}
  command mkdir -p -- "$destination" && command mv -i -- "$@"
}

nth() {
  if (( $# != 1 )) || [[ $1 != <1-> ]]; then
    print -u2 'usage: nth field-number'
    return 2
  fi
  command awk -v field="$1" '{ print $field }'
}

setlocale() {
  if (( $# != 1 )); then
    print -u2 'usage: setlocale locale'
    return 2
  fi
  if locale -a | command grep -Fqx -- "$1"; then
    export LANG=$1
    export LC_ALL=$1
  else
    print -u2 -- "$1 is not a valid locale. Try locale -a."
    return 1
  fi
}
